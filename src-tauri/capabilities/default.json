{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island-capability",
  "description": "The island: receive state events and call only the commands it uses. It cannot move or resize windows itself (`island_fit` does it, bounded, in Rust), and it cannot quit, uninstall hooks, change rules or GitHub settings.",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "allow-island-prefs",
    "allow-snapshot",
    "allow-island-fit",
    "allow-island-drag",
    "allow-island-pin",
    "allow-island-gaze-origin",
    "allow-island-cutout",
    "allow-opening-shown",
    "allow-away-now",
    "allow-respond",
    "allow-answer",
    "allow-open-settings",
    "allow-open-url",
    "allow-github-status",
    "allow-hooks-status",
    "allow-hooks-preview",
    "allow-hooks-install",
    "allow-updates-status",
    "allow-updates-set-enabled",
    "allow-updates-start"
  ]
}
